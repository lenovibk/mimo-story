generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Plan: "free" | "premium" | "family"
/// Gender: "boy" | "girl"

model Parent {
  id        String   @id @default(uuid())
  /// Null while the parent is a guest (auto-created on first app open, no email yet).
  email     String?  @unique
  isGuest   Boolean  @default(true)
  plan      String   @default("free")
  createdAt DateTime @default(now())

  children Child[]
}

model VerificationCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Child {
  id        String   @id @default(uuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name      String
  gender    String
  age       Int
  avatarKey String
  stars     Int      @default(0)
  createdAt DateTime @default(now())

  interests      ChildInterest[]
  favorites      Favorite[]
  storyProgress  StoryProgress[]
  dailyActivity  DailyActivity[]
  vocabProgress  VocabProgress[]

  @@index([parentId])
}

model ChildInterest {
  id       String @id @default(uuid())
  childId  String
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  interest String

  @@unique([childId, interest])
}

model Favorite {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  storyId   String
  createdAt DateTime @default(now())

  @@unique([childId, storyId])
}

model StoryProgress {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  storyId   String
  ratio     Float
  updatedAt DateTime @updatedAt

  @@unique([childId, storyId])
}

model DailyActivity {
  id             String   @id @default(uuid())
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  watchedSeconds Int      @default(0)

  @@unique([childId, date])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  /// "admin" | "editor"
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Category {
  id    String @id @default(uuid())
  /// Stable slug, e.g. "animals" - the app keys its local icon map off this.
  slug  String @unique
  label String
  /// Key into the app's fixed Phosphor icon map (see categoryVisuals.tsx).
  icon  String
  /// Hex background color for the category chip, e.g. "#FF92C2".
  color String
  order Int    @default(0)

  stories      Story[]
  programLinks ProgramCategoryLink[]
}

model Program {
  id        String   @id @default(uuid())
  /// Stable slug, e.g. "truyen" - the public API's "id" field, mirrors Category.
  slug      String   @unique
  label     String
  /// Key into the app's fixed program icon map (see programVisuals.tsx).
  icon      String
  color     String
  order     Int      @default(0)
  /// False while a program has no real content yet - hidden from the public API/app,
  /// still fully manageable in admin. Mirrors Story.published / Ad.active.
  published Boolean  @default(true)

  ages       ProgramAgeLink[]
  categories ProgramCategoryLink[]
  stories    StoryProgramLink[]
}

model ProgramAgeLink {
  id        String  @id @default(uuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// One of 3,4,5,6,7 ("7+"), matching Onboarding's fixed AGES picker exactly.
  age       Int

  @@unique([programId, age])
}

model ProgramCategoryLink {
  id         String   @id @default(uuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([programId, categoryId])
}

model Story {
  id            String   @id @default(uuid())
  title         String
  episodeLabel  String?
  coverUrl      String
  videoUrl      String?
  /// "UPLOAD" | "YOUTUBE"
  videoSourceType String @default("UPLOAD")
  youtubeId     String?
  subtitleEnUrl String?
  subtitleViUrl String?
  audioUrl      String?
  /// "VIDEO" | "AUDIO"
  mediaType     String   @default("VIDEO")
  duration      Int?
  /// "primary" | "yellow" | "pink" | "green" | "night"
  accent        String?
  minAge        Int?
  maxAge        Int?
  published     Boolean  @default(true)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tags     StoryTagLink[]
  programs StoryProgramLink[]
  conversionJobs ConversionJob[]
  vocabItems     VocabItem[]
  grammarPoints  GrammarPoint[]

  @@index([categoryId])
}

model StoryProgramLink {
  id        String  @id @default(uuid())
  storyId   String
  story     Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([storyId, programId])
}

model StoryTagLink {
  id      String @id @default(uuid())
  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// "new" | "featured"
  tag     String

  @@unique([storyId, tag])
}

model Ad {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  placement String    @default("home_banner")
  minAge    Int?
  maxAge    Int?
  active    Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  priority  Int       @default(0)
  createdAt DateTime  @default(now())
}

/// Tracks one ffmpeg/sharp media-compression run (image->webp or video->webm) so the
/// admin Media Monitor page can show live progress and keep history across server
/// restarts. storyId is set when the job belongs to a story's video field (the only
/// async path today - image conversion happens inline, see services/media.ts).
model ConversionJob {
  id          String    @id @default(uuid())
  /// "IMAGE" | "VIDEO"
  kind        String
  /// "QUEUED" | "PROCESSING" | "DONE" | "FAILED"
  status      String    @default("QUEUED")
  sourceName  String
  sourceBytes Int
  outputBytes Int?
  outputUrl   String?
  /// 0-1, only meaningful while status is PROCESSING
  progress    Float     @default(0)
  error       String?
  storyId     String?
  story       Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([storyId])
  @@index([status])
}

/// One vocabulary word for a story's "Từ vựng" lesson panel. Optionally anchored to the
/// EN subtitle cue it appears in (cueStart matches SubtitleItem.start in the app's SRT
/// parser) so the player can highlight/tap the word at the right moment in the dialogue;
/// cueText is a snapshot of that line's text at creation time, kept for admin context even
/// if the underlying .srt is edited later. Word-tap opens a flashcard (meaning + example),
/// self-checked via VocabProgress - no auto-graded quiz.
model VocabItem {
  id           String   @id @default(uuid())
  storyId      String
  story        Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  cueStart     Float?
  cueText      String?
  word         String
  /// IPA or simplified phonetic spelling, e.g. "/ˈbʌtərflaɪ/"
  phonetic     String?
  /// "noun" | "verb" | "adjective" | "adverb" | "phrase"
  partOfSpeech String?
  meaningVi    String
  exampleEn    String
  exampleVi    String
  imageUrl     String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  progress VocabProgress[]

  @@index([storyId])
}

/// One grammar point for a story's "Ngữ pháp" lesson panel - same cue-anchoring idea as
/// VocabItem, but usually spans a whole line rather than a single word.
model GrammarPoint {
  id            String   @id @default(uuid())
  storyId       String
  story         Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  cueStart      Float?
  cueText       String?
  title         String
  /// Short pattern, e.g. "S + am/is/are + V-ing"
  structure     String?
  explanationVi String
  exampleEn     String
  exampleVi     String
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storyId])
}

/// A child's self-check on one vocab word's flashcard ("Đã thuộc" / "Cần ôn thêm") -
/// mirrors StoryProgress's per-child upsert shape.
model VocabProgress {
  id        String    @id @default(uuid())
  childId   String
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  vocabId   String
  vocab     VocabItem @relation(fields: [vocabId], references: [id], onDelete: Cascade)
  /// "new" | "known"
  status    String    @default("new")
  updatedAt DateTime  @updatedAt

  @@unique([childId, vocabId])
}

