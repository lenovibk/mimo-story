generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Plan: "free" | "premium" | "family"
/// Gender: "boy" | "girl"

model Parent {
  id        String   @id @default(uuid())
  /// Null while the parent is a guest (auto-created on first app open, no email yet).
  email     String?  @unique
  isGuest   Boolean  @default(true)
  plan      String   @default("free")
  createdAt DateTime @default(now())

  children Child[]
}

model VerificationCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Child {
  id        String   @id @default(uuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name      String
  gender    String
  age       Int
  avatarKey String
  stars     Int      @default(0)
  createdAt DateTime @default(now())

  interests      ChildInterest[]
  favorites      Favorite[]
  storyProgress  StoryProgress[]
  dailyActivity  DailyActivity[]

  @@index([parentId])
}

model ChildInterest {
  id       String @id @default(uuid())
  childId  String
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  interest String

  @@unique([childId, interest])
}

model Favorite {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  storyId   String
  createdAt DateTime @default(now())

  @@unique([childId, storyId])
}

model StoryProgress {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  storyId   String
  ratio     Float
  updatedAt DateTime @updatedAt

  @@unique([childId, storyId])
}

model DailyActivity {
  id             String   @id @default(uuid())
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  watchedSeconds Int      @default(0)

  @@unique([childId, date])
}
