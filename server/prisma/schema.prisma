generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Plan: "free" | "premium" | "family"
/// Gender: "boy" | "girl"

model Parent {
  id        String   @id @default(uuid())
  /// Null while the parent is a guest (auto-created on first app open, no email yet).
  email     String?  @unique
  isGuest   Boolean  @default(true)
  plan      String   @default("free")
  createdAt DateTime @default(now())

  children Child[]
}

model VerificationCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Child {
  id        String   @id @default(uuid())
  parentId  String
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name      String
  gender    String
  age       Int
  avatarKey String
  stars     Int      @default(0)
  createdAt DateTime @default(now())

  interests      ChildInterest[]
  favorites      Favorite[]
  storyProgress  StoryProgress[]
  dailyActivity  DailyActivity[]

  @@index([parentId])
}

model ChildInterest {
  id       String @id @default(uuid())
  childId  String
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  interest String

  @@unique([childId, interest])
}

model Favorite {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  storyId   String
  createdAt DateTime @default(now())

  @@unique([childId, storyId])
}

model StoryProgress {
  id        String   @id @default(uuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  storyId   String
  ratio     Float
  updatedAt DateTime @updatedAt

  @@unique([childId, storyId])
}

model DailyActivity {
  id             String   @id @default(uuid())
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  watchedSeconds Int      @default(0)

  @@unique([childId, date])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  /// "admin" | "editor"
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Category {
  id    String @id @default(uuid())
  /// Stable slug, e.g. "animals" - the app keys its local icon map off this.
  slug  String @unique
  label String
  /// Key into the app's fixed Phosphor icon map (see categoryVisuals.tsx).
  icon  String
  /// Hex background color for the category chip, e.g. "#FF92C2".
  color String
  order Int    @default(0)

  stories      Story[]
  programLinks ProgramCategoryLink[]
}

model Program {
  id        String   @id @default(uuid())
  /// Stable slug, e.g. "truyen" - the public API's "id" field, mirrors Category.
  slug      String   @unique
  label     String
  /// Key into the app's fixed program icon map (see programVisuals.tsx).
  icon      String
  color     String
  order     Int      @default(0)
  /// False while a program has no real content yet - hidden from the public API/app,
  /// still fully manageable in admin. Mirrors Story.published / Ad.active.
  published Boolean  @default(true)

  ages       ProgramAgeLink[]
  categories ProgramCategoryLink[]
  stories    Story[]
}

model ProgramAgeLink {
  id        String  @id @default(uuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// One of 3,4,5,6,7 ("7+"), matching Onboarding's fixed AGES picker exactly.
  age       Int

  @@unique([programId, age])
}

model ProgramCategoryLink {
  id         String   @id @default(uuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([programId, categoryId])
}

model Story {
  id            String   @id @default(uuid())
  title         String
  episodeLabel  String?
  coverUrl      String
  videoUrl      String?
  subtitleEnUrl String?
  subtitleViUrl String?
  audioUrl      String?
  /// "VIDEO" | "AUDIO"
  mediaType     String   @default("VIDEO")
  duration      Int?
  /// "primary" | "yellow" | "pink" | "green" | "night"
  accent        String?
  minAge        Int?
  maxAge        Int?
  published     Boolean  @default(true)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  programId     String
  program       Program  @relation(fields: [programId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tags StoryTagLink[]

  @@index([categoryId])
  @@index([programId])
}

model StoryTagLink {
  id      String @id @default(uuid())
  storyId String
  story   Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// "new" | "featured"
  tag     String

  @@unique([storyId, tag])
}

model Ad {
  id        String    @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  placement String    @default("home_banner")
  minAge    Int?
  maxAge    Int?
  active    Boolean   @default(true)
  startAt   DateTime?
  endAt     DateTime?
  priority  Int       @default(0)
  createdAt DateTime  @default(now())
}

