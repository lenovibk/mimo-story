PORT=3002
JWT_SECRET=change-me-to-a-long-random-string

# MS SQL Server connection (Prisma sqlserver provider)
DATABASE_URL="sqlserver://HOST:PORT;database=DBNAME;user=USER;password=PASSWORD;trustServerCertificate=true"

# SMTP for verification code emails. If left empty, codes are logged to the
# server console instead of being emailed (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MimoKids <no-reply@mimokids.app>"

# Comma-separated list of origins allowed to call this API (Vite dev server, etc.)
CORS_ORIGINS=http://localhost:5173
