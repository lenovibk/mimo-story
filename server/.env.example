PORT=3002
JWT_SECRET=change-me-to-a-long-random-string
# Separate secret for admin panel tokens, so a parent token can never be replayed as an admin token.
ADMIN_JWT_SECRET=change-me-to-a-different-long-random-string

# MS SQL Server connection (Prisma sqlserver provider)
DATABASE_URL="sqlserver://HOST:PORT;database=DBNAME;user=USER;password=PASSWORD;trustServerCertificate=true"

# Where admin-uploaded story/ad files are written on disk (relative to server/).
UPLOAD_DIR=uploads
# Origin used to build public URLs for files under UPLOAD_DIR, e.g. https://api.mimokids.app
PUBLIC_UPLOAD_BASE_URL=http://localhost:3002
# Origin of the kids app (app/) itself, used ONLY to resolve the legacy seeded
# stories' app-relative cover/video/subtitle paths into absolute URLs for
# non-app clients (the admin panel). The kids app never uses this - it always
# resolves its own /stories/* paths against its own origin, which is what
# makes both web and Capacitor native builds work without this variable.
PUBLIC_APP_BASE_URL=https://app.mimokids.app

# SMTP for verification code emails. If left empty, codes are logged to the
# server console instead of being emailed (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MimoKids <no-reply@mimokids.app>"

# Comma-separated list of origins allowed to call this API (Vite dev server, etc.)
CORS_ORIGINS=http://localhost:5173
